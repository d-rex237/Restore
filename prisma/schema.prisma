
generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum OrderStatus {PENDING ACCEPTED DELIVERED CANCELLED}

enum Role {
  CUSTOMER
  DRIVER
  PROVIDER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String
  phone     String?
  avatarUrl String?
  role      Role     @default(CUSTOMER)

  customerProfile CustomerProfile?
  providerProfile ProviderProfile?
  driverProfile   DriverProfile?

  restaurants   Restaurant[]
  addresses     Address[]
  cart          Cart?
  customerOrders Order[] @relation("CustomerOrders")
  driverOrders   Order[] @relation("DriverOrders")
  favorites     Favorite[]
  reviews       Review[]
  notifications Notification[]
  roleRequests  RoleRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clerkId])
  @@index([role])
}

model CustomerProfile {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  loyaltyPoints Int @default(0)
  totalOrders Int @default(0)
  totalSpent Float @default(0)
}

model ProviderProfile {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  businessName String
  businessPhone String?
  verified Boolean @default(false)
}

model DriverProfile {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  vehicleType String
  plateNumber String
  licenseNumber String?
  isOnline Boolean @default(false)
  currentLatitude Float?
  currentLongitude Float?
}

model Restaurant {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields:[ownerId], references:[id])
  name String
  description String?
  imageUrl String?
  coverImageUrl String?
  address String
  phone String?
  email String?
  menuItems MenuItem[]
}

model MenuItem {
 id String @id @default(cuid())
 restaurantId String
 restaurant Restaurant @relation(fields:[restaurantId], references:[id], onDelete:Cascade)
 name String
 description String
 imageUrl String?
 price Float
 available Boolean @default(true)
 cartItems CartItem[]
 favorites Favorite[]
}

model Cart {
 id String @id @default(cuid())
 userId String @unique
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 items CartItem[]
}

model CartItem {
 id String @id @default(cuid())
 cartId String
 cart Cart @relation(fields:[cartId], references:[id], onDelete:Cascade)
 menuItemId String
 menuItem MenuItem @relation(fields:[menuItemId], references:[id])
 quantity Int @default(1)
 @@unique([cartId,menuItemId])
}

model Address{
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 label String
 address String
 city String
 orders Order[]
}

model Order{
 id String @id @default(cuid())
 customerId String
 customer User @relation("CustomerOrders",fields:[customerId],references:[id])
 driverId String?
 driver User? @relation("DriverOrders",fields:[driverId],references:[id])
 addressId String
 address Address @relation(fields:[addressId],references:[id])
 total Float
 status OrderStatus @default(PENDING)
}
model Favorite{ id String @id @default(cuid()) userId String menuItemId String user User @relation(fields:[userId],references:[id]) menuItem MenuItem @relation(fields:[menuItemId],references:[id]) @@unique([userId,menuItemId])}
model Review{ id String @id @default(cuid()) userId String restaurantId String rating Int comment String? user User @relation(fields:[userId],references:[id]) restaurant Restaurant @relation(fields:[restaurantId],references:[id])}
model Notification{ id String @id @default(cuid()) userId String user User @relation(fields:[userId],references:[id]) title String message String isRead Boolean @default(false)}
enum RequestStatus {PENDING APPROVED REJECTED}
model RoleRequest{ id String @id @default(cuid()) userId String user User @relation(fields:[userId],references:[id]) requestedRole Role status RequestStatus @default(PENDING)}
